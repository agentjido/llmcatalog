<div class="min-h-screen flex flex-col" style="background-color: hsl(var(--background));">
  <div
    id="live-seo-metadata"
    phx-hook="PageMetadata"
    data-indexing-enabled={to_string(PetalBoilerplateWeb.SEO.indexing_enabled?())}
    data-page-title={@page_title}
    data-page-description={@page_description}
    data-canonical-url={@canonical_url}
    data-robots={if @robots, do: Enum.map_join(@robots, ", ", &to_string/1)}
    data-og-image={@og_image}
    data-structured-data={Jason.encode!(List.wrap(@structured_data))}
    hidden
    aria-hidden="true"
  />

  <PetalBoilerplateWeb.ModelComponents.header search_value={@search_value} />

  <section
    :if={@live_action == :index}
    class="px-4 py-5 sm:px-6 sm:py-7"
    aria-labelledby="catalog-heading"
  >
    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
      <h1 id="catalog-heading" class="text-2xl font-semibold tracking-tight sm:text-3xl">
        LLM Catalog
      </h1>
      <span class="text-sm" style="color: hsl(var(--muted-foreground));">
        by
        <a
          href="https://jidokahq.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
          style="text-underline-offset: 3px;"
        >Jidoka Labs</a>
      </span>
    </div>
    <p class="mt-2 max-w-3xl text-sm leading-6" style="color: hsl(var(--muted-foreground));">
      Compare {format_number(@catalog_total)} models across {length(@providers)} providers by price,
      capabilities, context window, and modality.
    </p>
  </section>

  <PetalBoilerplateWeb.ModelComponents.filter_bar
    filters={@filters}
    providers={@providers}
    active_quick_filters={@active_quick_filters}
    filters_open={@filters_open}
  />

  <PetalBoilerplateWeb.ModelComponents.model_detail_modal
    model={@selected_model}
    history_events={@history_events}
    history_meta={@history_meta}
    history_available={@history_available}
    history_api_url={@history_api_url}
  />
  <PetalBoilerplateWeb.ModelComponents.comparison_modal
    is_open={@comparison_open}
    models={selected_models(assigns)}
  />

  <section
    class="flex-1 w-full max-w-full py-3 px-3 sm:px-4 md:py-4"
    aria-labelledby="model-results-heading"
  >
    <div class="mb-3 flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between">
      <div>
        <h2 id="model-results-heading" class="text-base font-semibold">Models</h2>
        <p class="mt-0.5 text-xs sm:text-sm" style="color: hsl(var(--muted-foreground));">
          <span class="font-medium" style="color: hsl(var(--foreground));">{@total}</span>
          of {@catalog_total}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 xl:justify-end">
        <form id="catalog-sort-form" phx-change="set_sort">
          <label class="sr-only" for="sort-select">Sort models</label>
          <select
            id="sort-select"
            name="sort"
            class="h-9 rounded-md border px-3 text-sm"
            style="border-color: hsl(var(--border)); background-color: hsl(var(--background)); color: hsl(var(--foreground));"
          >
            <option value="default" selected={sort_control_value(@sort) == "default"}>
              Trending
            </option>
            <option value="popular" selected={sort_control_value(@sort) == "popular"}>
              Most popular this week
            </option>
            <option value="newest" selected={sort_control_value(@sort) == "newest"}>
              Newest releases
            </option>
            <option value="intelligence" selected={sort_control_value(@sort) == "intelligence"}>
              Intelligence
            </option>
            <option
              value="recently_changed"
              selected={sort_control_value(@sort) == "recently_changed"}
            >
              Recently changed
            </option>
            <option value="provider" selected={sort_control_value(@sort) == "provider"}>
              Provider A–Z
            </option>
            <optgroup label="Model size">
              <option
                value="total_parameters_asc"
                selected={sort_control_value(@sort) == "total_parameters_asc"}
              >
                Total params: smallest first
              </option>
              <option
                value="total_parameters_desc"
                selected={sort_control_value(@sort) == "total_parameters_desc"}
              >
                Total params: largest first
              </option>
              <option
                value="active_parameters_asc"
                selected={sort_control_value(@sort) == "active_parameters_asc"}
              >
                Active params: smallest first
              </option>
              <option
                value="active_parameters_desc"
                selected={sort_control_value(@sort) == "active_parameters_desc"}
              >
                Active params: largest first
              </option>
              <option
                value="minimum_ram_gb_asc"
                selected={sort_control_value(@sort) == "minimum_ram_gb_asc"}
              >
                Minimum RAM: lowest first
              </option>
              <option
                value="minimum_ram_gb_desc"
                selected={sort_control_value(@sort) == "minimum_ram_gb_desc"}
              >
                Minimum RAM: highest first
              </option>
              <option
                value="minimum_vram_gb_asc"
                selected={sort_control_value(@sort) == "minimum_vram_gb_asc"}
              >
                Minimum VRAM: lowest first
              </option>
              <option
                value="minimum_vram_gb_desc"
                selected={sort_control_value(@sort) == "minimum_vram_gb_desc"}
              >
                Minimum VRAM: highest first
              </option>
            </optgroup>
            <option value="custom" disabled selected={sort_control_value(@sort) == "custom"}>
              Custom table sort
            </option>
          </select>
        </form>

        <%= if @total_pages > 1 do %>
          <div class="flex items-center gap-2">
            <button
              type="button"
              phx-click="page"
              phx-value-page={@page - 1}
              disabled={@page <= 1}
              class="px-3 py-1 text-sm border rounded-md disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
              style="border-color: hsl(var(--border)); color: hsl(var(--foreground));"
            >
              ← Prev
            </button>
            <span class="text-xs" style="color: hsl(var(--muted-foreground));">
              {@page} / {@total_pages}
            </span>
            <button
              type="button"
              phx-click="page"
              phx-value-page={@page + 1}
              disabled={@page >= @total_pages}
              class="px-3 py-1 text-sm border rounded-md disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
              style="border-color: hsl(var(--border)); color: hsl(var(--foreground));"
            >
              Next →
            </button>
          </div>
        <% end %>
      </div>
    </div>

    <div
      class="rounded-lg border overflow-hidden"
      style="border-color: hsl(var(--border)); background-color: hsl(var(--card));"
    >
      <PetalBoilerplateWeb.ModelComponents.model_table
        models={@models}
        sort={@sort}
        total={@total}
        selected_ids={@selected_ids}
        can_add_more={MapSet.size(@selected_ids) < 4}
      />
    </div>

    <%= if @total_pages > 1 do %>
      <div class="flex items-center justify-center gap-2 pt-4">
        <button
          type="button"
          phx-click="page"
          phx-value-page={@page - 1}
          disabled={@page <= 1}
          class="px-3 py-1.5 text-sm border rounded-md disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
          style="border-color: hsl(var(--border)); color: hsl(var(--foreground));"
        >
          ← Prev
        </button>
        <span class="text-sm" style="color: hsl(var(--muted-foreground));">
          Page {@page} of {@total_pages}
        </span>
        <button
          type="button"
          phx-click="page"
          phx-value-page={@page + 1}
          disabled={@page >= @total_pages}
          class="px-3 py-1.5 text-sm border rounded-md disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
          style="border-color: hsl(var(--border)); color: hsl(var(--foreground));"
        >
          Next →
        </button>
      </div>
    <% end %>
  </section>

  <section
    :if={@live_action == :index}
    class="mx-auto w-full max-w-5xl border-t px-4 py-10 sm:px-6"
    style="border-color: hsl(var(--border));"
    aria-labelledby="agent-access-heading"
  >
    <h2 id="agent-access-heading" class="text-2xl font-semibold tracking-tight">
      Developer and agent access
    </h2>
    <p class="mt-3 max-w-3xl leading-7" style="color: hsl(var(--muted-foreground));">
      Use the same public catalog through machine-readable interfaces. No account or API key is required for these read-only services.
    </p>

    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="rounded-lg border p-5" style="border-color: hsl(var(--border));">
        <h3 class="font-semibold">Versioned REST API</h3>
        <p class="mt-2 text-sm leading-6" style="color: hsl(var(--muted-foreground));">
          Read model metadata history through documented <code>/api/v1</code>
          routes and typed JSON responses.
        </p>
        <a class="mt-3 inline-block text-sm font-medium link" href="/openapi.json">OpenAPI 3.1</a>
      </article>
      <article class="rounded-lg border p-5" style="border-color: hsl(var(--border));">
        <h3 class="font-semibold">MCP and WebMCP tools</h3>
        <p class="mt-2 text-sm leading-6" style="color: hsl(var(--muted-foreground));">
          Search models, read exact records, and list providers through read-only agent tools.
        </p>
        <a class="mt-3 inline-block text-sm font-medium link" href="/developers">Developer guide</a>
      </article>
      <article class="rounded-lg border p-5" style="border-color: hsl(var(--border));">
        <h3 class="font-semibold">Local data package</h3>
        <p class="mt-2 text-sm leading-6" style="color: hsl(var(--muted-foreground));">
          Install the catalog for JavaScript and TypeScript applications that need local model metadata.
        </p>
        <a
          class="mt-3 inline-block text-sm font-medium link"
          href="https://www.npmjs.com/package/@agentjido/llmdb"
          target="_blank"
          rel="noopener noreferrer"
        >@agentjido/llmdb</a>
      </article>
    </div>
  </section>

  <section
    :if={@live_action == :index}
    id="frequently-asked-questions"
    class="mx-auto w-full max-w-5xl border-t px-4 py-10 sm:px-6"
    style="border-color: hsl(var(--border));"
    aria-labelledby="faq-heading"
  >
    <h2 id="faq-heading" class="text-2xl font-semibold tracking-tight">
      Frequently asked questions
    </h2>
    <div class="mt-6 grid gap-x-8 gap-y-6 md:grid-cols-2">
      <article>
        <h3 class="font-semibold">What is LLM Catalog?</h3>
        <p class="mt-2 leading-7" style="color: hsl(var(--muted-foreground));">
          LLM Catalog is a public database for comparing model providers, identifiers, capabilities, modalities, context windows, and recorded token prices.
        </p>
      </article>
      <article>
        <h3 class="font-semibold">Can software and AI agents use LLM Catalog?</h3>
        <p class="mt-2 leading-7" style="color: hsl(var(--muted-foreground));">
          Yes. The site provides Markdown pages, a versioned OpenAPI service, a read-only MCP server, and the @agentjido/llmdb npm package without an API key.
        </p>
      </article>
      <article>
        <h3 class="font-semibold">Does a zero recorded price guarantee free model access?</h3>
        <p class="mt-2 leading-7" style="color: hsl(var(--muted-foreground));">
          No. A zero value only reports the current catalog record. Provider limits, eligibility rules, and prices can change.
        </p>
      </article>
      <article>
        <h3 class="font-semibold">Where does the catalog data come from?</h3>
        <p class="mt-2 leading-7" style="color: hsl(var(--muted-foreground));">
          The open-source llmdb project normalizes public catalogs, provider APIs, and curated corrections into the records shown here.
        </p>
      </article>
    </div>
  </section>

  <%= if MapSet.size(@selected_ids) > 0 do %>
    <div
      class="sticky bottom-0 z-40 border-t"
      style="border-color: hsl(var(--border)); background-color: hsl(var(--background)/0.95); backdrop-filter: blur(8px);"
    >
      <div class="w-full max-w-full py-3 px-4">
        <div class="flex items-center justify-between gap-3">
          <div class="text-sm" style="color: hsl(var(--muted-foreground));">
            <span class="font-medium" style="color: hsl(var(--foreground));">
              {MapSet.size(@selected_ids)}
            </span>
            models selected
          </div>
          <div class="flex items-center gap-2">
            <button
              type="button"
              phx-click="clear_comparison"
              class="px-3 py-1.5 text-sm border rounded-md transition-colors"
              style="border-color: hsl(var(--border)); color: hsl(var(--foreground));"
            >
              Clear
            </button>
            <button
              id="comparison-trigger"
              type="button"
              phx-click={JS.push_focus() |> JS.push("open_comparison")}
              class="px-3 py-1.5 text-sm rounded-md flex items-center gap-1.5 transition-colors"
              style="background-color: hsl(var(--primary)); color: hsl(var(--primary-foreground));"
            >
              <.icon name="hero-arrows-right-left" class="h-4 w-4" /> Compare
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
