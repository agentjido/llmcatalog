<!DOCTYPE html>
<html lang="en" style="scrollbar-gutter: stable;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <% indexing_enabled? = PetalBoilerplateWeb.SEO.indexing_enabled?()
    canonical_status? = is_nil(@conn.status) or @conn.status == 200
    request_path = PetalBoilerplateWeb.PublicRoutes.normalize_path(@conn.request_path)
    search_indexable_path? = PetalBoilerplateWeb.SEO.search_indexable_path?(request_path)

    canonical_url =
      if indexing_enabled? and canonical_status? do
        assigns[:canonical_url] || PetalBoilerplateWeb.PublicRoutes.absolute(request_path)
      end

    robots =
      cond do
        not indexing_enabled? ->
          "noindex, nofollow"

        value = assigns[:robots] ->
          value
          |> List.wrap()
          |> Enum.map_join(", ", &to_string/1)

        @conn.query_string != "" ->
          "noindex, follow"

        not search_indexable_path? ->
          "noindex, follow"

        true ->
          nil
      end

    page_title = assigns[:page_title]
    page_description = assigns[:page_description] || PetalBoilerplateWeb.SEO.default_description()

    seo_item = %{
      title: page_title,
      description: page_description,
      canonical_url: canonical_url,
      url: canonical_url,
      robots: robots
    }

    og_image =
      assigns[:og_image] ||
        PetalBoilerplateWeb.PublicRoutes.absolute("/og/default.png")

    structured_data =
      assigns
      |> Map.get(:structured_data, [])
      |> List.wrap()
      |> Enum.reject(&is_nil/1)
      |> Enum.map(&Jason.encode!/1) %>

    <SEO.juice
      conn={@conn}
      config={PetalBoilerplateWeb.SEO.config()}
      page_title={page_title}
      item={seo_item}
    />

    <meta property="og:image" content={og_image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={og_image} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="LLM Catalog Model History"
      href={PetalBoilerplateWeb.PublicRoutes.absolute("/feed")}
    />

    <%= for json <- structured_data do %>
      <script type="application/ld+json" data-seo-structured-data>
        <%= Phoenix.HTML.raw(json) %>
      </script>
    <% end %>

    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />

    <script defer src="https://unpkg.com/@alpinejs/collapse@3.x.x/dist/cdn.min.js">
    </script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js">
    </script>
    <%= if Application.get_env(:petal_boilerplate, :enable_analytics) do %>
      <script async src={PetalBoilerplateWeb.Plugs.PlausibleProxy.script_path()}>
      </script>
      <script>
        window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
        plausible.init({endpoint: <%= Phoenix.HTML.raw(Jason.encode!(PetalBoilerplateWeb.Plugs.PlausibleProxy.event_path())) %>})
      </script>
    <% end %>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>

    <.color_scheme_switch_js />
  </head>
  <body class="antialiased bg-white dark:bg-gray-900">
    {@inner_content}
  </body>
</html>
